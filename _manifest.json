{
  "manifest_version": 2,
  "id": "github.cateye.model.switcher",
  "version": "1.0.0",
  "name": "峰谷模型切换",
  "description": "根据北京时间（UTC+8）峰谷时段定时调整 MaiBot model_config.toml 中各任务的模型列表顺序，将峰时/谷时指定的模型提升到列表首位（优先使用），在不重启服务的前提下平衡模型成本与性能。",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateyemizuki"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_model_switcher",
    "homepage": "https://github.com/cateyemizuki/cateye_model_switcher",
    "documentation": "https://github.com/cateyemizuki/cateye_model_switcher/blob/main/README.md",
    "issues": "https://github.com/cateyemizuki/cateye_model_switcher/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.13.3"
    }
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "timer"
    }
  },
  "capabilities": [
    "send.text",
    "send.image",
    "send.forward",
    "render.html2png"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
